---
import '../styles/global.css';
const {title='Blog Živé tabule',description='Novinky, tipy do výuky a příběhy ze zákulisí Živé tabule.',socialImage}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const absoluteImage = socialImage ? new URL(socialImage, Astro.site ?? Astro.url.origin).href : undefined;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta property="og:type" content="article"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    {absoluteImage && <meta property="og:image" content={absoluteImage}/>}
    <meta name="twitter:card" content={absoluteImage ? "summary_large_image" : "summary"}/>
    {absoluteImage && <meta name="twitter:image" content={absoluteImage}/>}

    <link rel="icon" type="image/png" href="/images/ziva_tabule_logo.png"/>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" aria-label="Hlavní navigace">
        <a class="brand-group brand-home" href="/" aria-label="Blog Živé tabule – úvodní stránka">
          <span class="brand-logo">
            <img src="/images/ziva_tabule_logo.png" alt="Logo Živé tabule" width="42" height="42"/>
          </span>
          <span class="brand">Blog Živé tabule</span>
        </a>
        <a class="external" href="https://tipy.zivatabule.cz/">Inspirace a návody ↗</a>
        <a class="external" href="https://zivatabule.cz/">Otevřít tabuli ↗</a>
      </nav>
    </header>
    <main><slot/></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="support">
          <p>Živá tabule je zdarma, bez registrace a bez reklam. Pomozte nám ji udržet v provozu.</p>
          <a class="support-link" href="https://zivatabule.cz/podpora">Podpořit Živou tabuli <span aria-hidden="true">♥</span></a>
        </div>
        <div class="footer-inner">
          <a href="https://app.pagescms.org/" target="_blank" rel="noopener noreferrer">Správa blogu ↗</a>
          <a href="https://zivatabule.cz/">zivatabule.cz ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>
