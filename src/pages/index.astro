---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../data/posts.js';
import { isPublished } from '../data/publication.js';
const posts = await getCollection('posts');
const shown = posts.filter(post => isPublished(post)).sort((a,b)=>String(b.data.date).localeCompare(String(a.data.date)));
---
<Base><div class="wrap"><section class="hero"><h1>Blog Živé tabule</h1><p class="lead">Novinky, tipy do výuky a příběhy ze zákulisí Živé tabule.</p></section><nav class="filters" aria-label="Rubriky"><button class="filter active" data-filter="all" aria-pressed="true">Všechny články</button><button class="filter" data-filter="Novinky" aria-pressed="false">Novinky</button><button class="filter" data-filter="Tipy do výuky" aria-pressed="false">Tipy do výuky</button><button class="filter" data-filter="Ze zákulisí" aria-pressed="false">Ze zákulisí</button></nav><section aria-label="Články">{shown.map(post=><article class="post" data-category={post.data.category}>{post.data.image && <a href={'/clanky/'+post.id+'/'} aria-label={'Otevřít článek '+post.data.title}><img class="post-image" src={post.data.image} alt="" loading="lazy" /></a>}<div class="meta">{post.data.category} · {formatDate(post.data.date)}</div><h2><a href={'/clanky/'+post.id+'/'}>{post.data.title}</a></h2><p class="summary">{post.data.description}</p></article>)}</section></div><script>document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{const value=button.getAttribute('data-filter');document.querySelectorAll('[data-filter]').forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});document.querySelectorAll('[data-category]').forEach(a=>{a.hidden=value!=='all'&&a.getAttribute('data-category')!==value;});}));</script></Base>