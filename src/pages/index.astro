---
import Base from '../layouts/Base.astro';
import {posts,formatDate} from '../data/posts.js';
const shown=[...posts].sort((a,b)=>b.date.localeCompare(a.date));
---
<Base><div class="wrap"><section class="hero"><h1>Blog Živé tabule</h1><p class="lead">Novinky, tipy do výuky a příběhy ze zákulisí Živé tabule.</p></section><nav class="filters" aria-label="Rubriky"><button class="filter active" data-filter="all" aria-pressed="true">Všechny</button><button class="filter" data-filter="Novinky" aria-pressed="false">Novinky</button><button class="filter" data-filter="Tipy do výuky" aria-pressed="false">Tipy do výuky</button></nav><section aria-label="Články">{shown.map(post=><article class="post" data-category={post.category}><div class="meta">{post.category} · {formatDate(post.date)}</div><h2><a href={'/clanky/'+post.slug+'/'}>{post.title}</a></h2><p class="summary">{post.description}</p></article>)}</section></div><script>document.querySelectorAll('[data-filter]').forEach(button=>button.addEventListener('click',()=>{const value=button.getAttribute('data-filter');document.querySelectorAll('[data-filter]').forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});document.querySelectorAll('[data-category]').forEach(a=>{a.hidden=value!=='all'&&a.getAttribute('data-category')!==value;});}));</script></Base>